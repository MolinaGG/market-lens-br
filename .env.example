# Copie para .env e preencha. Nunca faça commit do .env.
APIFY_API_TOKEN=
GROQ_API_KEY=
# Banco: Supabase (Postgres). Use a string de conexão do projeto.
DATABASE_URL=
# Local, sem Supabase: sqlite:///./data/market_lens.db
CACHE_BACKEND=none
REDIS_URL=
FORECAST_HORIZON_PREGOES=14
# Origens do site, separadas por vírgula. Ex.: https://market-lens-br.vercel.app
CORS_ORIGINS=http://localhost:5173
